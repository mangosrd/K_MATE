# K-MATE Backend Environment Variables
# 이 파일을 복사해서 .env 로 이름 바꾸고 값을 채워주세요

# ── 로컬 개발 ─────────────────────────────────────────────
# MySQL 연결 정보 (로컬에서 직접 실행할 때)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DB=kmate

# ── Railway 배포 ──────────────────────────────────────────
# Railway MySQL/PostgreSQL 플러그인을 추가하면 DATABASE_URL이 자동으로 주입됨.
# 아래 변수는 Railway 대시보드 > Variables 탭에서 수동으로 설정해야 하는 것들:
# DATABASE_URL=  ← Railway가 자동 주입 (직접 입력 불필요)
GEMINI_API_KEY=your_gemini_api_key_here
INTERNAL_API_SECRET=your_random_secret_here
PORTONE_API_SECRET=your_portone_secret_here
FRONTEND_URL=https://your-frontend-domain.vercel.app
GOOGLE_CLIENT_ID=your_google_oauth_web_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_web_client_secret
BACKEND_PUBLIC_URL=https://kmate-production.up.railway.app

# ── 공통 ──────────────────────────────────────────────────
BACKEND_PORT=8000

# Google Play 인앱결제 (안드로이드 앱 전용)
GOOGLE_PLAY_PACKAGE_NAME=com.kmate.app
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=path/to/service-account.json
